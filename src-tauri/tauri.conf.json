{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tailgate",
  "identifier": "pro.tb.nyabi.Tailgate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: media: http://media.localhost",
        "media-src": "media: http://media.localhost",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "GraphicsAndDesign",
    "copyright": "© 2026 Nyabi",
    "resources": {
      "resources/THIRD-PARTY-NOTICES.html": "THIRD-PARTY-NOTICES.html"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Korean"
        ]
      }
    }
  }
}
